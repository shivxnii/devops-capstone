{
 "title": "Task Manager - Overview",
 "uid": "tm-overview",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Container CPU (cores)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": ""
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[1m]))",
     "refId": "A",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Container Memory",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (name) (container_memory_usage_bytes{name!=\"\"})",
     "refId": "A",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "App request rate",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (endpoint,status) (rate(http_requests_total[1m]))",
     "refId": "A",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "p95 latency",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
     "refId": "A",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Target health (up)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": ""
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "up",
     "refId": "A",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Container last seen",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "time() - container_last_seen{name!=\"\"}",
     "refId": "A",
     "legendFormat": "{{name}}"
    }
   ]
  }
 ]
}